{
  "name": "pulsyn",
  "version": "0.1.0",
  "private": true,
  "description": "The AI-Native CDC Platform — Real-time change data capture without the complexity",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tinkss9/pulsyn"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:unit": "turbo test --filter='./packages/*'",
    "test:integration": "turbo test --filter='./tests/integration'",
    "test:e2e": "playwright test",
    "test:bench": "turbo test --filter='./tests/benchmarks'",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "swagger-ui-express": "^5.0.1",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
