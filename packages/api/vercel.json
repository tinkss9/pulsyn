{
  "version": 2,
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/replicate",
      "schedule": "*/1 * * * *"
    }
  ],
  "routes": [
    { "src": "/api/health", "dest": "/api/health.ts" },
    { "src": "/api/pipelines", "dest": "/api/pipelines.ts" },
    { "src": "/api/connectors", "dest": "/api/connectors.ts" },
    { "src": "/api/billing/plans", "dest": "/api/plans.ts" },
    { "src": "/api/cdc/start", "dest": "/api/cdc/start.ts" },
    { "src": "/api/cdc/stop", "dest": "/api/cdc/stop.ts" },
    { "src": "/api/cdc/status/(.*)", "dest": "/api/cdc/[pipelineId].ts" },
    { "src": "/api/cdc/engines", "dest": "/api/cdc/engines.ts" },
    { "src": "/api/cdc/events", "dest": "/api/cdc/events.ts" },
    { "src": "/api/cdc/replicate", "dest": "/api/cdc/replicate.ts" },
    { "src": "/api/cdc/errors", "dest": "/api/cdc/errors.ts" },
    { "src": "/api/cdc/reset", "dest": "/api/cdc/reset.ts" },
    { "src": "/api/keys", "dest": "/api/keys.ts" },
    { "src": "/api/security", "dest": "/api/security.ts" },
    { "src": "/api/blocked", "dest": "/api/blocked.ts" },
    { "src": "/api/admin-login", "dest": "/api/admin-login.ts" },
    { "src": "/api/cron/replicate", "dest": "/api/cron/replicate.ts" },
    { "src": "/api/(.*)", "dest": "/api/$1.ts" }
  ]
}
