# Pulsyn Environment Variables

# Database (required)
DATABASE_URL=postgresql://localhost:5432/pulsyn

# API Server
PORT=8080
NODE_ENV=development

# Stripe Billing (optional — needed for paid plans)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# API Authentication
PULSYN_API_KEY=your-api-key-here

# MCP Server
PULSYN_API_URL=http://localhost:8080
