# Pulsyn Environment Variables

# Supabase (required — replaces raw DATABASE_URL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API Server
PORT=8080
NODE_ENV=development

# Stripe Billing (optional — needed for paid plans)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# API Authentication
PULSYN_API_KEY=your-api-key-here

# MCP Server
PULSYN_API_URL=http://localhost:8080

# ─── Test Connector Credentials ─────────────────────────────
# Run `npx tsx scripts/setup-test-keys.ts` for guided setup
# Or set these manually:

# GitHub (free PAT — github.com/settings/tokens)
# TEST_GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# TEST_GITHUB_OWNER=your-username
# TEST_GITHUB_REPO=pulsyn

# Slack (free workspace — api.slack.com/apps)
# TEST_SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx

# Jira (free Atlassian account — id.atlassian.com/manage-profile/security/api-tokens)
# TEST_JIRA_HOST=your-team.atlassian.net
# TEST_JIRA_USER=you@example.com
# TEST_JIRA_API_TOKEN=ATATTxxxxxxxx

# HubSpot (free CRM — app.hubspot.com/signup-hubspot/marketing/free)
# TEST_HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx

# Stripe (test mode — dashboard.stripe.com/test/apikeys)
# TEST_STRIPE_API_KEY=sk_test_xxxxxxxxxxxx

# Shopify (free Partners dev store — partners.shopify.com)
# TEST_SHOPIFY_SHOP=your-dev-store
# TEST_SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx

# Supabase (free tier — app.supabase.com)
# TEST_SUPABASE_URL=https://xxxx.supabase.co
# TEST_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# BigQuery (free tier — console.cloud.google.com)
# TEST_BIGQUERY_PROJECT=my-project-123
# TEST_BIGQUERY_CREDENTIALS={"type":"service_account",...}

# Salesforce (free Dev Edition — signup.salesforce.com)
# TEST_SALESFORCE_INSTANCE=https://your-org.my.salesforce.com
# TEST_SALESFORCE_CLIENT_ID=3MVG9xxx...
# TEST_SALESFORCE_CLIENT_SECRET=ABC123...
# TEST_SALESFORCE_REFRESH_TOKEN=5Aep86xxx...

# AWS Kinesis (LocalStack or AWS Free Tier)
# TEST_KINESIS_HOST=http://localhost:4566
# TEST_KINESIS_USER=test
# TEST_KINESIS_PASS=test

# AWS Redshift (Redshift Serverless $300 free credits)
# TEST_REDSHIFT_HOST=mycluster.xxx.redshift.amazonaws.com
# TEST_REDSHIFT_PORT=5439
# TEST_REDSHIFT_DB=dev
# TEST_REDSHIFT_USER=admin
# TEST_REDSHIFT_PASS=MyPassword123

# Databricks (Community Edition — community.cloud.databricks.com)
# TEST_DATABRICKS_HOST=adb-xxx.azuredatabricks.net
# TEST_DATABRICKS_TOKEN=dapi_xxxxxxxxxxxx
# TEST_DATABRICKS_DB=hive_metastore
